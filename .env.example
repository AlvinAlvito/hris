# Salin menjadi .env.local lalu sesuaikan
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=posi_hris
DB_USER=posi_user
DB_PASS=GANTI_PASSWORD
# minimal 32 karakter acak, mis. hasil: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-32-karakter-acak-atau-lebih
# folder penyimpanan foto absensi, dokumen privat, dan logo (di luar folder public)
STORAGE_DIR=./storage
# foto absensi lebih tua dari ini dihapus oleh skrip pembersih
RETENSI_BULAN=6

# AI Asisten: kunci API dari console.groq.com (opsional; menu AI Asisten tidak berfungsi tanpa ini)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
